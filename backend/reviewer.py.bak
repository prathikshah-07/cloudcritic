"""LLM-powered reviewer for CloudCritic findings.

Provides two streaming functions:
  - stream_explain  : plain-language summary of findings (replaces explain_findings)
  - stream_chat     : conversational remediation chat with history

Both yield plain-text chunks from Groq's streaming API.  When the API key is
absent or the call fails, a single fallback chunk is yielded — callers never
see an exception.

The legacy ``explain_findings`` function is kept for backwards compatibility
with any code that still calls it; it collects the stream into one string.
"""

from __future__ import annotations

import json
import logging
import os
from collections.abc import Generator
from typing import TYPE_CHECKING, Any

import requests

if TYPE_CHECKING:
    from backend.models import Finding

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

_GROQ_URL = "https://api.groq.com/openai/v1/chat/completions"
_MODEL = "openai/gpt-oss-120b"
_TIMEOUT_SECONDS = 30

_FALLBACK_TEMPLATE = (
    "LLM review unavailable. "
    "{count} finding(s) detected: {summary}."
)

_EXPLAIN_SYSTEM_PROMPT = (
    "You are a senior AWS solutions architect reviewing a Well-Architected "
    "assessment. You will receive a JSON list of findings, each with a pillar, "
    "severity, description, and remediation guidance. "
    "Write a concise plain-language summary (no markdown, no bullet points) "
    "that a non-technical engineering manager can understand. "
    "Group observations by severity, highlight the most critical risks first, "
    "and close with one or two actionable next steps. "
    "Keep the response under 200 words."
)

_CHAT_SYSTEM_TEMPLATE = """\
You are a senior AWS solutions architect and Well-Architected reviewer.
The user has just scored the following architecture description:

--- ARCHITECTURE ---
{architecture}
--- END ARCHITECTURE ---

The scoring engine found these issues (JSON):
{findings_json}

Your role:
- Answer ONLY questions about this specific architecture and its findings.
- Give concrete, AWS-specific fixes: name the exact service, setting, or CLI command.
- Reference the rule IDs (e.g. SEC-001) when relevant to ground your answers.
- Keep each reply under 200 words unless the user explicitly asks for more detail.
- Do not invent findings that are not in the list above.
- Respond in plain prose — no bullet lists unless the user asks for them.\
"""


# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------


def _build_findings_json(findings: list[dict[str, Any]]) -> str:
    """Compact JSON string of finding dicts for the system prompt."""
    slim = [
        {
            "rule_id":     f.get("rule_id", ""),
            "pillar":      f.get("pillar", ""),
            "severity":    f.get("severity", ""),
            "description": f.get("description", ""),
            "remediation": f.get("remediation", ""),
        }
        for f in findings
    ]
    return json.dumps(slim, separators=(",", ":"))


def _findings_to_json(findings: list[Finding]) -> str:  # type: ignore[type-arg]
    """Compact JSON from Finding model objects (used by stream_explain)."""
    return json.dumps([f.to_dict() for f in findings], separators=(",", ":"))


def _deterministic_fallback(findings: list[Any]) -> str:
    """Return a consistent plain-text summary without any LLM call."""
    if not findings:
        return (
            "LLM review unavailable (GROQ_API_KEY not set). "
            "No findings to report — architecture passed all evaluated rules."
        )

    from collections import defaultdict

    by_severity: dict[str, list[str]] = defaultdict(list)
    for f in findings:
        # Accept both Finding model objects and plain dicts
        if hasattr(f, "severity"):
            sev = f.severity.value
            rid = f.rule_id
        else:
            sev = f.get("severity", "LOW")
            rid = f.get("rule_id", "?")
        by_severity[sev].append(rid)

    parts: list[str] = []
    for level in ("CRITICAL", "HIGH", "MEDIUM", "LOW"):
        ids = by_severity.get(level)
        if ids:
            parts.append(f"{len(ids)} {level}: {', '.join(ids)}")

    summary = "; ".join(parts)
    return _FALLBACK_TEMPLATE.format(count=len(findings), summary=summary)


def _stream_groq(
    messages: list[dict[str, str]],
    api_key: str,
) -> Generator[str, None, None]:
    """Yield text chunks from a Groq streaming chat-completions call.

    Parses the server-sent-events (SSE) response line by line, extracting
    ``delta.content`` from each ``data:`` frame.  Raises on HTTP errors so
    the caller can handle them.
    """
    payload = {
        "model": _MODEL,
        "messages": messages,
        "temperature": 0,
        "max_tokens": 600,
        "stream": True,
    }
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }

    with requests.post(
        _GROQ_URL,
        headers=headers,
        data=json.dumps(payload),
        timeout=_TIMEOUT_SECONDS,
        stream=True,
    ) as resp:
        resp.raise_for_status()
        for raw_line in resp.iter_lines():
            if not raw_line:
                continue
            line = raw_line.decode("utf-8") if isinstance(raw_line, bytes) else raw_line
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                chunk = json.loads(data)
                content = chunk["choices"][0]["delta"].get("content")
                if content:
                    yield content
            except (KeyError, ValueError, IndexError):
                continue


# ---------------------------------------------------------------------------
# Public streaming API
# ---------------------------------------------------------------------------


def stream_explain(findings: list[Finding]) -> Generator[str, None, None]:  # type: ignore[type-arg]
    """Stream a plain-language Groq explanation of *findings*.

    Yields plain-text chunks suitable for a StreamingResponse.
    Never raises — falls back to a single deterministic chunk on any error.

    Args:
        findings: List of Finding model objects from the scoring engine.

    Yields:
        str chunks as they arrive from the Groq API.
    """
    api_key = os.environ.get("GROQ_API_KEY", "").strip()

    if not api_key:
        logger.debug("GROQ_API_KEY not set; yielding deterministic fallback.")
        yield _deterministic_fallback(list(findings))
        return

    if not findings:
        yield "No findings to report — your architecture passed all evaluated rules."
        return

    messages = [
        {"role": "system", "content": _EXPLAIN_SYSTEM_PROMPT},
        {"role": "user",   "content": _findings_to_json(findings)},
    ]

    try:
        yield from _stream_groq(messages, api_key)
    except requests.exceptions.Timeout:
        logger.warning("Groq stream_explain timed out; yielding fallback.")
        yield _deterministic_fallback(list(findings))
    except requests.exceptions.HTTPError as exc:
        logger.warning(
            "Groq stream_explain HTTP %s: %s; yielding fallback.",
            exc.response.status_code,
            exc.response.text[:200],
        )
        yield _deterministic_fallback(list(findings))
    except (requests.exceptions.RequestException, ValueError) as exc:
        logger.warning("Groq stream_explain failed (%s); yielding fallback.", exc)
        yield _deterministic_fallback(list(findings))


def stream_chat(
    architecture: str,
    findings: list[dict[str, Any]],
    history: list[dict[str, str]],
    message: str,
) -> Generator[str, None, None]:
    """Stream a remediation chat response from Groq.

    Args:
        architecture: Raw architecture text that was scored.
        findings:     List of finding dicts (rule_id, severity, pillar,
                      description, remediation).
        history:      Prior turns as [{role, content}, …].  Roles must be
                      "user" or "assistant".
        message:      The latest user message.

    Yields:
        str chunks as they arrive from the Groq API.
    """
    api_key = os.environ.get("GROQ_API_KEY", "").strip()

    if not api_key:
        logger.debug("GROQ_API_KEY not set; yielding chat fallback.")
        yield (
            "Chat is unavailable — GROQ_API_KEY is not configured. "
            "Set the key in your .env file and restart the server."
        )
        return

    system_content = _CHAT_SYSTEM_TEMPLATE.format(
        architecture=architecture.strip(),
        findings_json=_build_findings_json(findings),
    )

    # Build message list: system + history + new user message
    # Filter history to only valid roles to prevent prompt injection
    safe_history = [
        {"role": turn["role"], "content": turn["content"]}
        for turn in history
        if turn.get("role") in ("user", "assistant")
        and isinstance(turn.get("content"), str)
    ]

    messages: list[dict[str, str]] = (
        [{"role": "system", "content": system_content}]
        + safe_history
        + [{"role": "user", "content": message}]
    )

    try:
        yield from _stream_groq(messages, api_key)
    except requests.exceptions.Timeout:
        logger.warning("Groq stream_chat timed out; yielding fallback.")
        yield "The request timed out. Please try again."
    except requests.exceptions.HTTPError as exc:
        logger.warning(
            "Groq stream_chat HTTP %s: %s; yielding fallback.",
            exc.response.status_code,
            exc.response.text[:200],
        )
        yield f"The LLM service returned an error ({exc.response.status_code}). Please try again."
    except (requests.exceptions.RequestException, ValueError) as exc:
        logger.warning("Groq stream_chat failed (%s); yielding fallback.", exc)
        yield "Chat is temporarily unavailable. Please try again."


# ---------------------------------------------------------------------------
# Legacy non-streaming API (backwards compat)
# ---------------------------------------------------------------------------


def explain_findings(findings: list[Finding]) -> str:  # type: ignore[type-arg]
    """Collect the stream_explain generator into a single string.

    Kept for backwards compatibility.  New code should use stream_explain.
    """
    return "".join(stream_explain(findings))
